<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed for Supabase sync when online -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the app detect connectivity changes (used by navigator.onLine) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Needed for notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Needed for offline voice speech-to-text recognition -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.LifeEasy">

        <receiver
            android:name=".AlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Today's Checklist Widget -->
        <receiver
            android:name=".widgets.TodayChecklistWidgetProvider"
            android:exported="true"
            android:label="Today's Checklist">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.lifeeasy.widgets.ACTION_TOGGLE_TASK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_checklist_info" />
        </receiver>

        <service
            android:name=".widgets.ChecklistRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Daily Counters Widget -->
        <receiver
            android:name=".widgets.DailyCountersWidgetProvider"
            android:exported="true"
            android:label="Daily Counters">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.lifeeasy.widgets.ACTION_ADJUST_COUNTER" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_daily_counters_info" />
        </receiver>

        <activity
            android:name=".widgets.CounterWidgetConfigActivity"
            android:exported="true"
            android:label="Select Widget Counters">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <service
            android:name=".widgets.CounterRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Next Academic Class Widget -->
        <receiver
            android:name=".widgets.NextClassWidgetProvider"
            android:exported="true"
            android:label="Next Class">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_class_info" />
        </receiver>

        <activity
            android:name=".widgets.ChecklistWidgetConfigActivity"
            android:exported="true"
            android:label="Select Checklist Category">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Today's Planner Widget -->
        <receiver
            android:name=".widgets.TodayPlannerWidgetProvider"
            android:exported="true"
            android:label="Today's Planner">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_planner_info" />
        </receiver>

        <service
            android:name=".widgets.PlannerRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- School / Academic Countdown Widget -->
        <receiver
            android:name=".widgets.AcademicCountdownWidgetProvider"
            android:exported="true"
            android:label="Upcoming Exams">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_academic_countdown_info" />
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>